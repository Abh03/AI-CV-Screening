{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "recruiter": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/recruiter",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": [{ "glob": "**/*", "input": "public" }]
          },
          "configurations": { "production": { "budgets": [{ "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" }] } },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "recruiter:build" } },
        "test": { "builder": "@angular/build:unit-test", "options": { "tsConfig": "tsconfig.spec.json", "buildTarget": "recruiter:build", "runnerConfig": "vitest.config.mts" } }
      }
    }
  }
}
