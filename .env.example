# Copy to a private deployment secret store or docker/.env. Never commit populated values.
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-url-encoded-password@postgres:5432/cv_engine
ENCRYPTION_SECRET_KEY=replace-with-fernet-key
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes-from-secret-manager
# Optional legacy service credentials, never used by the browser.
API_TOKENS_JSON=
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-provider-key
GROQ_API_KEY=
OPENROUTER_API_KEY=
